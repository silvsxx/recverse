# RecVerse Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public URL (used by client patcher)
PUBLIC_BASE_URL=https://your-domain.com

# Database (YugabyteDB / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5433/database?sslmode=require
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=20

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
SESSION_EXPIRATION=86400
REFRESH_TOKEN_EXPIRATION=604800

# Game Version
GAME_VERSION=20250424.01
SUPPORTED_GAME_VERSIONS=20250424.01,20260323.14
ROLLOUT_GAME_VERSIONS=

# Email (for password recovery, email verification)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@your-domain.com

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=52428800

# Logging
LOG_LEVEL=info

# RecNet Service URLs (used by patcher to configure client)
# These will be served by the NameServer endpoint
RECNET_AUTH_URL=https://your-domain.com/auth
RECNET_API_URL=https://your-domain.com/api
RECNET_ACCOUNTS_URL=https://your-domain.com/accounts
RECNET_ECON_URL=https://your-domain.com/econ
RECNET_COMMERCE_URL=https://your-domain.com/commerce
RECNET_ROOMS_URL=https://your-domain.com/rooms
RECNET_MATCH_URL=https://your-domain.com/match
RECNET_CHAT_URL=https://your-domain.com/chat
RECNET_NOTIFY_URL=https://your-domain.com/notify
RECNET_PLAYERSETTINGS_URL=https://your-domain.com/playersettings
RECNET_LEADERBOARD_URL=https://your-domain.com/leaderboard
RECNET_DISCOVERY_URL=https://your-domain.com/discovery
RECNET_CDN_URL=https://your-domain.com/cdn
RECNET_IMG_URL=https://your-domain.com/img
RECNET_STUDIO_URL=https://your-domain.com/studio
RECNET_DATA_URL=https://your-domain.com/data
RECNET_LISTS_URL=https://your-domain.com/lists
RECNET_ROOMCOMMENTS_URL=https://your-domain.com/roomcomments
RECNET_DATACOLLECTION_URL=https://your-domain.com/datacollection

# Photon Configuration (for client-side redirection)
# These are configured in the patcher and versemain.dll
PHOTON_REDIRECT_ENABLED=true
PHOTON_TARGET_HOST=your-photon-host.example.com
PHOTON_NAMESERVER_PORT=5058
PHOTON_MASTER_PORT=5055
PHOTON_GAME_PORT=5056
PHOTON_APP_ID_REALTIME=your-realtime-app-id
PHOTON_APP_ID_VOICE=your-voice-app-id
PHOTON_APP_ID_CHAT=your-chat-app-id